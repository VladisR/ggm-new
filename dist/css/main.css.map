.anchors
    padding lf(16px, 32px) lf(16px, 36px) lf(16px, 32px)
    background var(--surface3)
    margin lf(36px, 40px) 0 lf(32px, 40px)

    &__title
        font-size lf(20, 20.01)
        line-height lf(32px, 32.01px)
        text-transform uppercase
        display flex
        align-items center
        border 0
        padding 0
        background none
        font-weight 500
        color var(--neutral-900)
        cursor pointer
        .svg-icon
            margin-left lf(15px, 15.01px)
            width lf(10px, 10.01px)
            height lf(6px, 6.01px)
            transform rotateX(180deg)
            transition 0.25s transform

    &.is-closed
        & ^[0]
            &__title
                .svg-icon
                    transform rotateX(0)

    &__list
        padding-top lf(22px, 26px)
        padding-bottom lf(0px, 6px,)
        margin 0
        li
            padding-left 0
            margin-bottom lf(20px, 20.01px)
            font-weight 500
            &:last-child
                margin-bottom 0
            &:before
                display none

            a
                text-decoration none
                color var(--neutral-900)
                display inline-block
                &:hover
                    color var(--teal-300)
        ul
            padding 0 0 0 lf(32px, all)
            margin lf(4px, all) 0 lf(20px, all)
            li
                margin-bottom lf(8px, all)
                &:last-child
                    margin-bottom 0
                a
                    font-size lf(14px, all)
                    line-height lf(20px, all)
                    color var(--neutral-600)


.partner-review
    .anchors
        padding-left 0
        // @media (min-width: $mq.lg)
        //     position sticky
        //     top lf(138px, 157px)
            // top lf(152px, 177px)

        .anchors__title,
        ul li a
            padding-left lf(16px, 36px)
            position relative
        ul li a
            &.is-active
                color var(--teal-400)
                &:before
                    content ''
                    position absolute
                    left 0
                    top: lf(-2px, -6px)
                    bottom: lf(-2px, -6px)
                    width lf(2px, 4px)
                    background var(--teal-400)
        ul li ul li a
            padding-left lf(20px, all)
            &.is-active
                color var(--teal-400)
                &:before
                    display none
