.site-video
    position relative
    margin lf(24px, 24.01px) 0
    max-height 80svh
    overflow hidden
    transform-style: preserve-3d;
    backface-visibility: hidden;
    &:last-child
        margin-bottom 0
    &__container
        background var(--surface3)
        position relative
        text-decoration none
        color var(--neutral-900)
        &:hover
            color var(--teal-400)
            .play-icon
                background var(--teal-400)

    &__poster
        position relative
        display block

    &__duration
        position absolute
        right 20px
        bottom 20px
        font-size lf(12px, 12.01px)
        color var(--white)

    &__box
        position absolute
        left 50%
        top 50%
        transform translate(-50%, -50%)
        text-align center
        display flex
        justify-content center
        align-items center
        flex-direction column

        span.play-icon
            position static
            transform translate(0)

    &__note
        margin-top lf(16px, 20px)
        color var(--white)
        font-weight 500
        font-size lf(14, 14.01)
        display flex
        align-items center
        .svg-icon
            width lf(13px, 13.01px)
            height lf(13px, 13.01px)
            margin-left lf(6px, 6.01px)

    .play-icon
        position absolute
        left 50%
        top 50%
        transform translate(-50%, -70%)  translateZ(10px)
        will-change: transform;
        pointer-events: none;
        width lf(40px, 84px)
        height lf(40px, 84px)
        border 2px solid rgba(#E7F9FA, 0.5)
        border-radius 100%
        padding-left 3px
        background unquote('rgba(var(--white-rgb), 0.3)')
        transition 0.25s background
        pointer-events none
        z-index 2

    &:hover
        .play-icon
            background var(--teal-400)
            .svg-icon
                margin auto
                width 55%
                height 55%
                fill var(--white)
                svg
                    width 100%
                    height 100%

    img
        display block
        width 100%
        height 100%
        object-fit cover

    iframe
        width 100%
        display block
        border 0
        width 100%
        height 100%
        object-fit cover

    video
        width 100%
        height 100%
        max-height 80svh
        object-fit contain
        background #000
        transform: translateZ(0);
        will-change: transform;
        -webkit-transform: translateZ(0);

    video::-webkit-media-controls-start-playback-button
        display: none !important;
        -webkit-appearance: none;


    &__text
        display block
        font-size lf(12, 12.01)
        line-height lf(16px, 16.01)
        margin-top lf(8px, 8.01px)

    &.is-playing
        .play-icon
            display none
