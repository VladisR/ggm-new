.catalog
    padding lf(52px, 120px) 0 0

    &__items
        display flex
        flex-direction column
        row-gap lf(16px, 20px)

        padding-left lf(16px, 72px)
        padding-right lf(16px, 72px)

        margin-left lf(-16px, -72px)
        margin-right lf(-16px, -72px)

        @media (min-width: $mq.md)
            display grid
            grid-template-columns: repeat(2, 1fr);
            gap lf(20px, all)

        @media (min-width: $mq.lg)
            grid-template-columns: repeat(2, 1fr);

        @media (min-width: $mq.xl)
            grid-template-columns: repeat(3, 1fr);

    .header-block
        max-width lf(636px, all)
        @media (min-width: $mq.lg)
            max-width lf(636px, all)
            margin-left auto
            margin-right auto
            text-align center

    &__button
        text-align center
        margin-top lf(40px, 48px)
        .site-button
            width 100%
            @media (min-width: $mq.md)
                width auto

    &__body
        display none
        &.is-visible
            display block

    .link-arr
        margin-top lf(32px, 30px)

    .tabs-titles
        margin-bottom lf(32px, all)
        @media (min-width: $mq.lg)
            &__items
                justify-content center

    &__controls
        display none
        @media (min-width: $mq.lg)
            display flex


.catalog[data-mobile-column="true"]
    .catalog__items
        display: grid !important;
        grid-template-rows: repeat(2, 1fr);
        grid-auto-flow: column;
        grid-auto-columns: max-content;
        overflow-x: auto;
        gap: lf(16px, 24px);
        scrollbar-width: none;

        &::-webkit-scrollbar
            display: none;

        @media (min-width: $mq.lg)
            overflow-x: visible;
            grid-auto-flow: row;
            grid-template-rows: auto;
            grid-auto-columns: auto;
            display grid
            grid-template-columns: repeat(2, 1fr);

        @media (min-width: $mq.xl)
            grid-template-columns: repeat(3, 1fr);

.catalog
    &--recommendet
        padding-top 0
        padding-bottom 0
        margin-bottom lf(36px, 44px)
        & ^[0]
            &__title
                font-size lf(14, all)
                text-transform uppercase
                line-height lf(20px, all)
                margin-bottom lf(12px, all)

            &__items
                padding-left 0
                padding-right 0
                margin-left 0
                margin-right 0
                display block
        @media (min-width: $mq.md)
            & ^[0]
                &__items
                    display: grid;
                    grid-template-columns: repeat(2, 1fr);

        @media (min-width: $mq.xxxl)
            & ^[0]
                &__items
                    grid-template-columns: repeat(3, 1fr);

.catalog
    &--columns
        @media (min-width: $mq.md)
            & ^[0]
                &__items
                    grid-template-columns: repeat(1, 1fr);

        @media (min-width: $mq.xxxl)
            & ^[0]
                &__items
                    grid-template-columns: repeat(1, 1fr);


.catalog
    &--simple
        padding 0 0 lf(36px, 38px)
        margin 0 0 lf(20px, 32px)
        border-bottom 1px solid var(--light-grey)
        & ^[0]

            &__title
                font-size lf(20, all)
                line-height lf(32px, all)
                margin-bottom lf(20px, 24px)

            &__items
                padding 0
                margin 0
                @media (min-width: $mq.xl)
                    grid-template-columns: repeat(2, 1fr);

.catalog
    &__header
        display none

    &.table-view
        @media (min-width: $mq.xl)
            display block
            & ^[0]

                &__header
                    background var(--surface3)
                    display: table-row

                    &-th
                        padding lf(16px, 16.01px) lf(20px, 20.01px)
                        font-weight 500

                        display: table-cell
                        vertical-align: middle
                        white-space: nowrap
                        &:nth-child(2)
                            width lf(132px, all)
                        &:nth-child(3)
                            width lf(201px, all)
                        &:nth-child(4)
                            width lf(138px, all)
                        &:nth-child(5)
                            width lf(193px, all)

                &__items
                    display: table
                    width: 100%
                    border-collapse: collapse

.main-page
    .catalog
        padding-bottom lf(52px, 120px)

.catalog:has(+ .pagination)
    border 0
    padding-bottom 0


.catalog
    &.new-programs
        .header-block
            max-width none
            text-align left
        & ^[0] {}



.catalog
    &.has-slider
        margin-top lf(48px, 80px)
        padding-top 0
        overflow hidden

        .entity-card-wrapper
            width: lf(332px, 416px, (393 992));
            .entity-card
                width auto


        .header-block
            padding-top lf(28px, 48px)
            border-top 1px solid var(--light-grey)
            margin-bottom lf(32px, 48px)
            max-width none
            &__title
                font-size lf(28, 40)
                line-height lf(36px, 52px)
                margin-bottom 0

        .swiper
            margin-left 0
            margin-right 0
            overflow visible

        @media (min-width: $mq.lg)
            .header-block
                text-align left
            & ^[0]
                &__items
                    gap 0 !important
                    display flex !important
                    flex-direction: row
                    // overflow hidden
                    margin-left 0
                    margin-right 0
                    padding-left 0
                    padding-right 0

            .swiper-col
                margin-right lf(20.3px, 24px)
                width 48.88%
                >*
                    margin-bottom lf(20.3px, 24px)
                    &:last-child
                        margin-bottom 0

            // .swiper-slide
            //     width lf(438px, 346px, (992 1200))
            //     // width 500px
            //     margin-right lf(20.3px, 24px)
            //     margin-bottom lf(20.3px, 24px)
