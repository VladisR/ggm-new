.calendar-simple

    &__box
        margin-bottom lf(20px, all)

    &__button
        .site-button
            width 100%
            border-color var(--teal-400)
            color var(--teal-400)
            &:hover
                background var(--teal-400)
                .svg-icon
                    fill var(--white)
                    transform translate(0)

            .svg-icon
                fill var(--teal-400)
                width lf(12px, all)
                height lf(12px, all)
                margin-right lf(8px, all)
                transform translate(0)
                transition 0.35s fill

    @media (min-width: $mq.xl)
        position sticky
        top lf(150px, 165px, (1200 1440))
        bottom 0
        &__button
            display none
