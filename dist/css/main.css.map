.recommended-materials

    &__content
        border-top 1px solid var(--light-grey)
        padding-top lf(32px, 48px)

    &__header
        margin-bottom lf(32px, 32.01px)

    &__title
        margin-bottom lf(20px, 20.01px)
        &:last-child
            margin-bottom 0

    &__text
        font-size lf(16, 18)
        // color var(--neutral-800)
        font-weight 500

    &__grid
        margin-bottom lf(-28px, -28.01px)

    &__item
        margin-bottom lf(28px, 28.01px)
        font-weight 500
        padding-top lf(28px, 28.01px)
        border-top 1px solid var(--light-grey)

        &:hover
            & ^[0]
                &__item-img
                    img
                        transform scale(1.02)

        &:first-child
            padding-top 0
            border 0

        &-link,
        &-img,
        &-author,
        &-text
            display block


        &-img
            margin-bottom lf(12px, 17px)
            overflow hidden
            img
                display block
                width 100%
                transition 0.25s transform
                will-change transform

        .post-meta
            margin-bottom lf(1px, 1.01px)
            &__category
                font-size lf(12, 12.01)
            &__author
                font-size lf(14, 14.01)

        &-text
            margin-top lf(4px, 7px)
            font-size lf(16, 16.01)
            line-height lf(24px, 24.01px)
            text-decoration none
            color var(--neutral-900)

    &__controls
        display none

    &__button
        margin-top lf(32px, 48px)

    @media (min-width: $mq.lg)
        &__grid
            display: grid
            grid-template-columns: repeat(3, 1fr)
            gap: 0 lf(24px, 24.01px)

        &__item
            padding-top 0
            border 0

        &__controls
            display flex
            justify-content flex-end
            margin-top lf(24px, all)
            &.is-locked
                display none
            .swiper-button
                background none
                position static
                transform translate(0)
                border 0
                cursor pointer
                width lf(32px, all)
                height lf(32px, all)
                margin-left lf(32px, all)
                backdrop-filter none
                &.swiper-button-lock
                    display none
                .svg-icon
                    fill var(--neutral-500)
                &:hover
                    background none
                    .svg-icon
                        fill: var(--teal-500);

.recommended-materials
    &--photos
        & ^[0]
            &__header
                margin-bottom lf(32px, 48px)
            &__title
                margin-bottom lf(8px, 8.01px)
                letter-spacing -0.008em

            &__text
                font-size lf(18, 18.01)

            &__grid

                padding-left lf(16px, 72px)
                padding-right lf(16px, 72px)

                margin-left lf(-16px, -72px)
                margin-right lf(-16px, -72px)

                display flex
                gap 0 lf(16px, 24px)
                flex-flow row
                overflow hidden
                overflow-x auto

                scrollbar-height none
                scrollbar-width: none;
                -ms-overflow-style: none;
                &::-webkit-scrollbar
                    display none

            &__item
                width 332px
                flex none
                padding-top 0
                border 0
                &-img
                    margin-bottom lf(16px, 16.01)
                &-text
                    font-size lf(18, 18.01)
                    line-height lf(28px, 28.01px)

    @media (min-width: $mq.lg)
        &--photos
            & ^[0]
                &__grid
                    flex-flow wrap
                    overflow-x visible
                    display: grid
                    grid-template-columns: repeat(3, 1fr)
                    gap: 0 lf(24px, 24.01px)
                    margin-left 0
                    margin-right 0
                    padding 0

                &__item
                    width auto


body
    .recommended-materials
        &--news
            .swiper
                padding-left lf(16px, 72px)
                padding-right lf(16px, 72px)
                margin-left lf(-16px, -72px)
                margin-right lf(-16px, -72px)

.recommended-materials
    &--news
        .swiper
        & ^[0]
            &__grid
                padding-left lf(16px, 72px)
                padding-right lf(16px, 72px)
                margin-left lf(-16px, -72px)
                margin-right lf(-16px, -72px)
                margin-bottom 0

                display flex
                gap 0
                flex-flow row
                overflow hidden
                overflow-x auto

                scrollbar-height none
                scrollbar-width: none;
                -ms-overflow-style: none;
                &::-webkit-scrollbar
                    display none

                >*
                    width lf(356px, 440px, (393 992));
                    flex none

        @media (min-width: $mq.lg)
            & ^[0]
                &__grid
                    overflow visible
                    gap 0
                    >*
                        width 34%
                        flex-grow 1

.container
    .recommended-materials__in
        padding-left 0 !important
        padding-right 0 !important
