
.entity-card
    padding lf(12px, 20px) lf(12px, 20px) lf(14px, 22px)
    background var(--surface3)
    display: grid
    grid-template-columns: auto auto auto 1fr;
    align-items: start
    text-decoration none
    color var(--neutral-800)
    position relative
    &:hover
        color var(--neutral-800)
        & ^[0]
            &__avatar
                color var(--white)

    &__link
        position absolute
        left 0
        top 0
        width 100%
        height 100%

    &__name,
    &__meta-info,
    &__meta-info-2,
    &__socials
        justify-self: start

    &__col
        display: contents;

    &__avatar
        flex none
        margin-right lf(16px, 16.01px)
        color var(--white)
        grid-column: 1;
        grid-row: span 3;
        text-decoration none


        &-img
            border-radius 100%
            overflow hidden
            width lf(40px, 60px)
            height lf(40px, 60px)
            position relative
            font-size lf(18, 24)
            text-align center
            display block
            font-weight 500
            line-height lf(40px, 60px)
            text-transform uppercase
            &:before
                content ''
                position absolute
                left 0
                top 0
                width 100%
                height 100%
                box-shadow inset 0 0 0 1px var(--neutral-500)
                border-radius 100%
                opacity 0.2

        // span
        //     width 100%
        //     height 100%
        //     display block

        img
            display block

    &__name
        font-weight 500
        font-size lf(16, 18)
        line-height lf(20px, 28px)
        margin-bottom lf(2px, 4px)
        color var(--neutral-900)
        grid-column: 2 / span 2;
        grid-row: 1;
        text-decoration none

    &__info,
    &__info-2
        font-size lf(14, 14.01)
        line-height lf(20px, 20.01px)

    &__info
        grid-column: 2;
        grid-row: 2;
        +
            & ^[0]
                &__info-2
                    padding-left lf(12px, 12.01px)
                    margin-left lf(8px, 8.01px)
                    &:before
                        content ''
                        width lf(4px, 4.01px)
                        height lf(4px, 4.01px)
                        border-radius 100%
                        position absolute
                        left 0
                        top lf(8.5px, all)
                        background var(--neutral-400)

    &__info-2
        position relative
        grid-column: 3;
        grid-row: 2;

    &__socials
        grid-column: 2 / span 2;
        grid-row: 3;
        margin-top lf(10px, 10.01px)

        &-items
            display flex
            gap 0 lf(16px, 10.01px)

        &-link
            text-decoration none
            width lf(20px, 20.01px)
            height lf(20px, 20.01px)
            display flex
            img, svg
                margin auto
                width 76%
            svg
                transition 0.25s fill, 0.25s transform

        &-link
            &:hover
                svg
                    transform translateY(-2px)
                    path
                        fill var(--teal-300)

    @media (min-width: $mq.lg)
        align-items center

.contacts-list,
.catalog
    @media (min-width: $mq.xl)
        &.table-view
            .entity-card
                display: table-row
                background none
                border-bottom 1px solid var(--light-grey)

                > *
                    padding lf(8px, 8.01px) lf(20px, 20.01px)

                &__col
                    display: table-cell !important
                    vertical-align: middle
                    padding: lf(8px, 8.01px) 0 lf(8px, 8.01px) lf(20px, 20.01px)
                    font-size 0
                    width 100%
                    max-width 35.7%
                    white-space: nowrap

                    .entity-card__avatar
                        display: inline-block !important
                        vertical-align: middle
                        &-img
                            width lf(40px, 40.1px)
                            height lf(40px, 40.1px)
                        span
                            font-size lf(18, 18.01)
                            line-height lf(39px, 39.01px)

                    .entity-card__name
                        display: inline-block !important
                        vertical-align: middle
                        padding-left: 0
                        width: calc(100% - lf(56px, 56.1px))
                        white-space normal
                        font-size lf(16, 16.01)

                &__avatar
                    position static
                    transform translate(0)

                &__info
                    display: table-cell !important
                    vertical-align: middle

                &__info-2
                    display: table-cell !important
                    vertical-align: middle

                    &:before
                        display none

                &__socials
                    display: table-cell !important
                    vertical-align: middle
                    white-space: nowrap
                    &-items
                        justify-content space-between

                    > a
                        display: inline-flex

                &__status
                    display table-cell
                    white-space nowrap
                    .svg-icon,
                    .txt
                        display inline-block

                    .svg-icon
                        transform translateY(0.5px)


                &__text
                    display table-cell

.catalog
    &.table-view
        @media (min-width: $mq.xl)
            .entity-card
                &__col
                    width 184px
                    max-width 184px
                &__name
                    margin-bottom 0
                &__status
                    .txt
                        font-size lf(12, all)
                        color var(--green-500)

                &__info-2
                    font-size lf(12, all)
                &__info
                    padding-top 0
                    padding-bottom 0
                    float none

                &__text
                    font-size lf(14, all)
                    vertical-align middle
                    text-transform none

.catalog
    .entity-card
        display block
        position relative
        min-height lf(66px, 100px)
        padding-left lf(68px, 96px)

        width: lf(332px, 416px, (393 992));
        flex: none !important;
        max-width: none !important;

        &__col
            display contents

        &__avatar
            position absolute
            left lf(12px, 20px)
            top lf(12px, 20px)
            // margin 0

        &__name
            display inline-block
            vertical-align middle
            margin-right lf(5px, all)

        &__status
            display inline-flex
            vertical-align middle
            margin-top lf(-2px, all)
            .svg-icon
                width lf(12px, all)
                height lf(13.5px, all)
                fill #09924E

            .txt
                display none

        &__text
            display block
            margin-top lf(3px, all)
            font-size lf(12, all)
            text-transform uppercase
            line-height lf(16px, all)

        &__info
            float left
            margin-right lf(8px, all)

        &__info,
        &__info-2
            margin-top lf(2px, 4px)

        &__info-2
            overflow hidden
            display block
            letter-spacing -0.01em

    @media (min-width: $mq.lg)
        .entity-card
            width 100%
    @media (min-width: $mq.xl)
        .entity-card
            width 100%
            &__avatar
                top 50%
                transform translateY(-50%)


.catalog
    &--recommendet
        .entity-card
            width auto
            margin-bottom lf(20px, 24px)
            background var(--surface4)
            &:last-child
                margin-bottom 0
            @media (min-width: $mq.md)
                margin-bottom 0

.catalog
    &--simple
        .entity-card
            width auto
