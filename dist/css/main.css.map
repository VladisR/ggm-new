.autors-badge
    margin-bottom lf(36px, 40px)
    .author-badge
        margin-bottom 0

    .author-badge + .author-badge
        margin-top lf(20px, all)

    @media (min-width: $mq.md)
        display flex

        .author-badge + .author-badge
            margin-top 0
            padding-left lf(25px, 40px)
            margin-left lf(25px, 40px)
            border-left 1px solid var(--light-grey)


.author-badge
    display flex
    align-items center
    margin-bottom lf(25px, 40px)
    &:last-child
        margin-bottom 0

    &__avatar,
    &__name,
    &__overname,
    &__role
        display block

    &__avatar
        width lf(32px, 40px)
        height lf(32px, 40px)
        margin-right lf(8px, 12px)
        overflow hidden
        border-radius 100%
        border 1px solid unquote("rgba(var(--border), 0.2)")
        img
            display block
            width 100%
            height 100%
            object-fit cover

    &__col
        display block

    &__overname
        font-weight 300
        font-size lf(12px, all)
        margin-bottom lf(0px, 2px)
        line-height lf(16px, all)

    &__name
        font-size lf(14, 14.01)
        line-height lf(20px, all)
        font-weight 500
        color var(--neutral-600)
        text-decoration none

    &__role
        line-height lf(20px, 20.01px)
        font-size lf(14, 14.01)
        color var(--surface-2)

blockquote, .blockquote
    .author-badge
        margin-top lf(14px, 14.01)
        &__avatar
            width lf(40px, all)
            height lf(40px, all)

        &__name
            font-size lf(16, all)
            line-height lf(24px, all)
            color var(--neutral-800)
