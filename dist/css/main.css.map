  // CHARTS
  --chart-teal: #2C8C90;
  --chart-green: #2C8C90;
  --chart-cyan: #4D95EF;
  --chart-purple: #9E56E2;
  --chart-spark: #4BBFB0;

  --chart-bg: #ffffff;
  --chart-borders: #CBD1D9;
  --chart-grid: #E8E8EA;

  --chart-text-main: #484A4E;
  --chart-text-dark: #1a1a1a;
  --chart-text-muted: #555555;
  --chart-text-legend: #333333;

  --chart-tooltip-shadow: rgba(0, 0, 0, 0.08);

  --chart-grad-teal-start: rgba(75, 191, 176, 0.22);
  --chart-grad-teal-end: rgba(75, 191, 176, 0.01);
  --chart-grad-spark-start: rgba(75, 191, 176, 0.3);

  /* Размеры, отступы и шрифты */
  --chart-font-size-base: 12px;
  --chart-font-size-tooltip: 14px;
  --chart-font-size-legend: 14px;

  --chart-tooltip-padding-y: 12px;
  --chart-tooltip-padding-x: 16px;
  --chart-tooltip-border-radius: 0px; /* Без закруглений */

  --chart-dot-size: lf(8px, all);
  --chart-dot-margin: lf(6px, all);

  --chart-legend-box-width: 22px;
  --chart-legend-box-height: 6px;
  --chart-legend-padding: 20px;

  --chart-point-radius: 0;          /* Размер точек на графике всегда (поставьте 0, если хотите только при наведении) */
  --chart-point-hover-radius: 12;    /* Размер точек при наведении мыши */
  --chart-point-border-width: 2;    /* Толщина белой обводки точки */

.is-dark-theme
  --chart-teal: #43B0B5
  --chart-green: #43B0B5
  --chart-cyan: #4D95EF
  --chart-purple: #9E56E2
  --chart-spark: #2C8C90
  --chart-bg: #091117
  --chart-borders: rgba(#85A1B9, 0.2)
  --chart-grid: #1B2C38
  --chart-text-main: #C0C6CE
  --chart-text-dark: #FFFDFD
  --chart-text-muted: #FFFDFD
  --chart-text-legend: #FFFDFD
