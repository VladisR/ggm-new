.page-banner
    margin lf(40px, 80px) 0 lf(52px, 96.1px)

    &:last-child
        margin-bottom 0

    &__content
        margin 0 lf(-16px, -72px)
        transition 0.25s box-shadow
        &:hover
            box-shadow 0 0 15px unquote("rgba(var(--black), 0.2)")
        @media (min-width: $mq.lg)
            margin-left 0
            margin-right 0


    a, img
        display block
    img
        width 100%

    @media (min-width: $mq.lg)
        margin-left 0
        margin-right 0

.container__in + .page-banner
    margin-top lf(40px, 80px)

.container__in:has(+ .page-banner)
    padding-bottom 0


.container
    .page-banner
        &__in
            padding-left 0
            padding-right 0

.main-page
    .page-banner
        margin 0
        &--margin-top
            margin-top lf(40px, 80px)
        &--margin-bottom
            margin-bottom lf(52px, 96.1px)
        &__in
            @media (min-width: $mq.lg)
                padding-left 0
                padding-right 0


.page-banner:has(+ .has-bg),
.page-banner:has(+ .partners),
.page-banner:has(+ .masonry-grid)
    margin-bottom 0
