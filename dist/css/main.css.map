.calendar-simple

    &__box
        margin-bottom lf(20px, all)

    &__button
        .site-button
            width 100%
            border-color var(--teal-400)
            color var(--teal-400)
            &:hover
                background var(--teal-400)
                .svg-icon
                    fill var(--white)
                    transform translate(0)

            .svg-icon
                fill var(--teal-400)
                width lf(12px, all)
                height lf(12px, all)
                margin-right lf(8px, all)
                transform translate(0)
                transition 0.35s fill

    &__reset-date
        display flex
        align-items center
        margin 0 auto
        padding 0
        border 0
        background none
        min-height lf(32px, all)
        margin-top lf(12px, all)
        color var(--teal-400)
        font-weight 500
        font-size lf(14, all)
        padding-left lf(12px, all)
        display none
        .svg-icon
            margin-top lf(2.5px, all)
            margin-right lf(8px, all)
            width lf(10px, all)
            height lf(10px, all)
            fill var(--teal-500)
        &.is-visible
            display flex

    @media (min-width: $mq.xl)
        position sticky
        top lf(150px, 152px, (1200 1440))
        bottom 0
        &__button
            display none
