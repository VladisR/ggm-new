.page-slider
    margin-top lf(46px, 58px)
    margin-bottom lf(46px, 58px)
    &:last-child
        margin-bottom 0

    &__container
        position relative

    &__thumbs
        &.swiper
            padding-top lf(16px, 24.01px)
            padding-left lf(16px, 72px)
            padding-right lf(16px, 72px)
            padding-bottom 4px
            margin-bottom -4px

    &__thumb
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
        cursor pointer

        &.swiper-slide
            width 30.5%
            margin-right lf(10px, 16.01px)
            padding lf(2px, all)
            &:last-child
                margin-right 0

        &.swiper-slide-thumb-active
            box-shadow 0 0 0 lf(2px, all) var(--teal-500)


    &__counter
        position absolute
        left lf(8px, 16px)
        bottom lf(8px, 16px)
        z-index 1
        padding lf(2px, 4px) lf(4px, all)
        background rgba(#0F0F0F, 0.8)
        color var(--white)
        border-radius lf(2px, all)
        font-size lf(12, all)
        line-height lf(16px, all)
        span
            display block

    @media (min-width: $mq.md)
        &__thumb
            overflow hidden
            display flex
            &.swiper-slide
                width 22.642%
                flex-shrink: 0 !important

    @media (min-width: $mq.lg)
        margin-left 0
        margin-right 0

        &__thumbs
            &.swiper
                padding-left 3px
                padding-right 3px

body
    .swiper
        margin-left lf(-16px, -72px)
        margin-right lf(-16px, -72px)
        @media (min-width: $mq.lg)
            margin-left 0
            margin-right 0

    .swiper-button
        width lf(40px, 40.01px)
        height lf(40px, 40.01px)
        display flex
        justify-content center
        align-items center
        padding 0
        top 50% !important
        transform translateY(-50%)
        border-radius 100%
        background rgba(#0F0F0F, 0.4)
        backdrop-filter blur(10px)
        border 1px solid rgba(#EDF5F4, 0.5)
        margin-top 0 !important
        &.swiper-button-disabled
            pointer-events auto

        &:after
            display none

        &.swiper-button-prev
            left lf(16px, 16.01px)
        &.swiper-button-next
            right lf(16px, 16.01px)

        .svg-icon
            fill var(--white)

        &:not(.swiper-button-disabled)
            &:hover
                background: rgba(0, 67, 70, 0.4);
                border-color: #004346;
                // .svg-icon
                //     fill #64E7EC


        &.swiper-button-disabled
            opacity 1
            .svg-icon
                fill var(--neutral-400)


    .swiper-pagination
        position static
        display flex
        flex-wrap wrap
        justify-content center
        margin-top lf(20px, 32px)
        padding-bottom 2px

    .swiper-slide
        img
            display block


    .swiper-pagination-bullet
        width lf(8px, 8.01px) !important
        height lf(8px, 8.01px) !important
        margin 0 lf(6px, 6.01px) !important
        position relative
        &:before
            content ''
            position absolute
            left -7px
            top -7px
            right -7px
            bottom -7px

        &.swiper-pagination-bullet-active
            background var(--teal-400)
            box-shadow 0 0 0 lf(1px, 1.01px) var(--teal-400)

    .swiper-nav
        display none
        @media (min-width: $mq.lg)
            display flex
            justify-content flex-end
            margin-top lf(24px, all)
            &.is-locked
                display none
            .swiper-button
                background none
                position static
                transform translate(0)
                border 0
                cursor pointer
                width lf(32px, all)
                height lf(32px, all)
                margin-left lf(32px, all)
                backdrop-filter none
                &.swiper-button-disabled
                    pointer-events none
                    opacity 0.7
                &.swiper-button-lock
                    display none
                .svg-icon
                    fill var(--neutral-500)
                &:hover
                    background none
                    .svg-icon
                        fill: var(--teal-500);
            &:has(.swiper-button-lock)
                display none
