.checkbox
    display inline-flex
    position relative
    margin-right lf(12px, 12.01px)
    vertical-align top
    flex none
    &__input
        position absolute
        left 0
        top 0
        width 100%
        height 100%
        opacity 0
        cursor pointer
    &__icon
        width lf(20px, 20.01px)
        height lf(20px, 20.01px)
        position relative
        border 1px solid var(--blue)
        border-radius 1px
        &:after
            content ''
            position absolute
            left 0
            top 0
            width 100%
            height 100%

    &__input:checked + &__icon
        background var(--teal-500)
        border-color var(--teal-500)
        &:after
            background var(--checkboxMark) center center no-repeat
            background-size 56%


.checkbox
    &--switch
        & ^[0]
            &__icon
                width lf(40px, all)
                height lf(22px, all)
                border-radius lf(40px, all)
                background var(--blue)
                transition 0.15s background
                &:after
                    position absolute
                    right 100%
                    top 50%
                    margin-top -18.4%
                    left lf(4px, all)
                    width 36.86%
                    height 70%
                    border-radius 100%
                    background var(--white)
                    transition 0.15s left

        .checkbox__input:checked + .checkbox__icon
            &:after
                background var(--white)
                left 50.5%
                right lf(4px, all)
