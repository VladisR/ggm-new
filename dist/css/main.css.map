.tooltip
    display inline-block
    vertical-align top
    position relative
    text-align center
    text-decoration none
    // &:hover
    //     & ^[0]
    //         &__content
    //             opacity 1
    //             visibility visible
    &__icon
        position relative
        width lf(13.3px, all)
        height lf(13.3px, all)
        display flex
        justify-content center
        align-items center
        cursor pointer
        .svg-icon
            width 100%
            height 100%
            fill var(--teal-400)

    &__content
        position absolute
        background var(--white)
        text-transform none
        padding lf(8px, all)
        // bottom: 100%
        // left 50%
        // transform translateX(-50%)
        min-width lf(155px, all)
        margin-bottom 15px
        font-weight 400
        box-shadow 0 2px 12px rgba(#1A1C1D, 0.06)
        font-size lf(12, all)
        line-height lf(16px, all)
        // opacity 0
        // visibility hidden
        // transition 0.25s opacity, 0.25s visibility
        color var(--neutral-900)
        display none
        &.is-active
            display block !important
        &:after
            content ''
            position absolute
            top 100%
            left 50%
            transform translateX(-50%)
            border-left: 9px solid transparent;
            border-right: 9px solid transparent;
            border-top: 10px solid var(--white);

    &--left,
    &--right
        text-align left

    &--right
        & ^[0]
            &__content
                transform translateX(0)
                left auto
                margin-right -6px
                right 0
                &:after
                    transform translateX(0)
                    left auto
                    right 5px
    &--left
        & ^[0]
            &__content
                transform translateX(0)
                left 0
                margin-left -6px
                &:after
                    transform translateX(0)
                    left auto
                    left 5px
