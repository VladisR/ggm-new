.hero-advertising
    margin-top lf(-7px, -43px, (393 767))
    // margin-top -9.8%
    padding-bottom lf(56px, 76px)
    &__in
        text-align center
    &__image
        position relative
        margin-bottom lf(16px, all)
        img
            background none
            width 100%
            display block
        &:after
            pointer-events none
            content ''
            position absolute
            left 0
            right 0
            bottom 0
            height lf(124px, all)
            background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, #FFFFFF 100%);

    &__label
        font-size lf(11, 14)
        line-height lf(11px, 20px)
        letter-spacing 2%
        color var(--neutral-600)
        text-transform uppercase
        font-weight 500
        margin-bottom lf(12px, 10px)

    &__title
        font-family var(--inter)
        font-size lf(30, 50)
        line-height 1.2
        letter-spacing 3%
        margin-bottom lf(12px, 23px)
        br
            display none

    &__text
        font-size lf(16, 20)
        margin-bottom lf(24px, 30px)

    &__links
        display flex
        flex-wrap wrap
        align-items center
        justify-content center
        gap lf(16px, all) lf(16px, 44px)
        margin-left 50px
        margin-right 50px

    &__scroll-down
        margin lf(34px, 64px) auto 0
        background none
        border 0
        padding 0
        display none
        .svg-icon
            display block
            width lf(15px, all)
            height lf(17px, all)


    .decor-button
        padding-top lf(8px, all)
        padding-bottom lf(12px, all)

    @media (min-width: $mq.md)
        margin-top lf(-90px, -124px, (768 991))
        height 100svh
        display flex
        justify-content flex-end
        align-items flex-end
        &__scroll-down
            display block
            position relative
            z-index 1
            .svg-icon
                // fill var(--neutral-900)
                cursor: pointer;
                animation: float-vertical 1.8s infinite ease-in-out;
            &:hover
                .svg-icon
                    animation-play-state: paused;

        &__title
            br
                display block

        &__image
            &:after
                display none

        &__content
            margin-top -18%
            position relative
            z-index 1
            max-width 70%
            margin-left auto
            margin-right auto
            &:before
                content ''
                position absolute
                opacity 0.5
                left 0
                top 0
                right 0
                bottom 0
                margin lf(-80px, -137px) -24% lf(-126px, -157px)
                border-radius 100%
                background #FFF
                pointer-events none
                filter blur(150px)
            >*
                position relative

        &__text
            max-width lf(475px, all)
            margin-left auto
            margin-right auto

    @media (min-width: $mq.lg)
        margin-top lf(-88px, -140px, (992 1440))
        min-height 736px
        &__text
            max-width lf(580px, 640px)

    @media (min-width: $mq.xxxl)
        &__content
            max-width lf(907px, all)

        // &__text
        //     max-width lf(640px, all)


.header-has-button
    .hero-advertising
        margin-top -2.5%
        @media (min-width: $mq.md)
            margin-top -10%

@keyframes float-vertical {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8px);
  }
}
