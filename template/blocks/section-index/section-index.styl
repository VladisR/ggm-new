.section-index
    display flex
    color var(--neutral-900)
    padding-top lf(12px, all)
    font-size lf(12, all)
    line-height 1.2
    lettr-spacing 1%
    margin-bottom lf(48px, 72px)
    border-top 1px solid var(--neutral-900)
    text-transform uppercase
    font-weight 700
    &__counter
        min-width lf(28px, 86px)
        margin-right lf(35px, 224px)
