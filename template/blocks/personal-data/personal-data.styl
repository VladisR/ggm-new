.personal-data

    p,
    table
        &:first-child
            margin-top 0

        &:last-child
            margin-bottom 0

    h2
        margin lf(36px, 48px) 0 lf(16px, 16.01px)
        font-size lf(28, 28.01)
        line-height lf(36px, 36.01px)
        letter-spacing -0.01em

    p
        margin lf(12px, 12.01px) 0

    .wp-block-table
        margin lf(16px, 16.01px) 0
        table
            border 0

    .wp-block-table td
        border-left 0
        border-top 0
        border-right 0

    .wp-block-table table,
    table
        hyphens: auto;
        th[scope="row"],
        tr td:first-child
            width 45.35%
            vertical-align top
            font-weight 500
            background: var(--surface3);
            @media (min-width: $mq.sm)
                width 34.35%
        th,
        td:first-child
            line-height lf(24px, 24.01px)
            font-size lf(16, all)
        td
            font-size lf(14, all)

        th, td
            letter-spacing 0
